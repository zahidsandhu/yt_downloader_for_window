{
  "manifest_version": 3,
  "name": "YT Downloader Helper",
  "version": "1.0",
  "description": "YouTube video ko Video Downloader app me bhejta hai (Native Messaging).",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Video Downloader",
    "default_popup": "popup.html"
  }
}